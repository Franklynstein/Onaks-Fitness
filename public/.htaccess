# SPA routing: serve index.html for client-side routes (/programs, /admin, /login, etc.)
# Real files and folders are served directly. Copied into dist/ by Vite at build time.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
