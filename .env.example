# Onaks Fitness — environment variables for the new backend (Supabase + Resend + your Stripe).
# Copy to .env.local (frontend, Vite) and set the server-only vars as Supabase Edge Function
# secrets. Nothing here is wired yet (Phase 0). Do NOT commit real values.

# ---- Frontend (Vite, exposed to the browser) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=        # your Stripe publishable key (pk_live_ / pk_test_)
VITE_TINYMCE_API_KEY=               # existing: admin rich-text editor

# ---- Server-only: set as Supabase Edge Function secrets (never VITE_, never in the bundle) ----
# supabase secrets set KEY=value
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # bypasses RLS; used by edge functions only
RESEND_API_KEY=                     # Resend (transactional email)
RESEND_FROM_EMAIL=hello@onaksfitness.com   # verified Resend sender
STRIPE_SECRET_KEY=                  # your Stripe secret key (sk_live_ / sk_test_)
STRIPE_WEBHOOK_SECRET=              # from the Stripe webhook endpoint (whsec_...)
SITE_URL=https://onaksfitness.com   # for Stripe success/cancel redirects
